<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>FastData.Untility</AssemblyName>
    <RootNamespace>FastData.Untility</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1591</NoWarn>
    <!-- 本项目 net452 组需要显式版本（绕开 outer-graph 钉定），与 CPM 混用，项目级关闭 CPM 校验 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- NuGet 打包配置 -->
    <PackageId>FastData.Untility</PackageId>
    <Description>FastData ORM 框架配套工具库，提供缓存、Redis、序列化、加密等通用功能</Description>
    <PackageTags>FastData;Utility;Cache;Redis;Helper;DotNet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 允许测试项目访问内部成员 -->
  <ItemGroup>
    <InternalsVisibleTo Include="FastData.Tests" />
  </ItemGroup>

  <!-- 打包文件 -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- .NET Framework 4.5.2 专用引用 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.Entity" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Messaging" />
    <Reference Include="System.Net" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Routing" />
    <Reference Include="System.ServiceModel.Web" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml" />
    <!-- net452 专用 NuGet 包。
         说明：sln 级 restore 的 outer graph 阶段 TargetFramework 为空，ItemGroup 条件不生效，
         该阶段会看到无条件评估的引用；VersionOverride 在该阶段不可靠。
         此处用显式 Version 并在项目级关闭 CPM 校验（NU1008），确保任何阶段都拿到兼容版本。 -->
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="NPOI" Version="2.5.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.SelfHost" Version="5.2.9" />
    <PackageReference Include="Microsoft.Win32Ex" Version="1.2.0.0" />
    <PackageReference Include="NServiceKit.Redis" Version="1.0.17" />
    <PackageReference Include="NServiceKit.Common" Version="1.0.31" />
    <PackageReference Include="NServiceKit.Text" Version="1.0.10" />
    <!-- 元组语法支持（net452 缺失） -->
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <!-- .NET 8/10 专用包引用 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net452'">
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
    <!-- 安全钉版：ConfigurationManager 间引入的旧版本带多条高危公告 -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="NewLife.Redis" Version="6.5.2026.601" />
  </ItemGroup>

  <!-- 排除 net452 专用文件（.NET 6+ 不编译） -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net452'">
    <Compile Remove="RedisInfo.cs" />
    <Compile Remove="Repository\RedisRepository.cs" />
    <Compile Remove="Cache\BaseSession.cs" />
    <Compile Remove="Cache\BaseCookie.cs" />
    <Compile Remove="Host\WcfHost.cs" />
    <Compile Remove="Host\WcfBinding.cs" />
    <Compile Remove="Host\WebApiHost.cs" />
    <Compile Remove="Host\ServiceThrottlingAttribute.cs" />
    <Compile Remove="WinService\Service.cs" />
    <Compile Remove="WinService\Win32PSI.cs" />
    <Compile Remove="WinService\ConfigWin32.cs" />
    <Compile Remove="WinService\ConfigWin32PSI.cs" />
  </ItemGroup>

</Project>
