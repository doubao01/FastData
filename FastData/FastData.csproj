<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;net8.0;net10.0</TargetFrameworks>
    <AssemblyName>FastData</AssemblyName>
    <RootNamespace>FastData</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1570;CS1572;CS1573;CS1711;CS1712</NoWarn>
    <!-- NuGet 打包配置 -->
    <PackageId>Fast.Data</PackageId>
    <Description>轻量级高性能 ORM 框架，支持多数据库（SQL Server/MySQL/PostgreSQL/Oracle/SQLite/DB2），提供连接池、分片、缓存、消息队列等企业级特性</Description>
    <PackageTags>ORM;Database;SQL;MySQL;PostgreSQL;SQLite;SqlServer;DotNet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 打包文件 -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 允许测试项目访问内部成员 -->
  <ItemGroup>
    <InternalsVisibleTo Include="FastData.Tests" />
  </ItemGroup>

  <!-- .NET Framework 4.5 专用引用 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <!-- OperationsPanel 的接口探测用 HttpClient，net452 需显式引用 -->
    <Reference Include="System.Net.Http" />
    <!-- 元组语法支持（net452 缺失） -->
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>

  <!-- .NET 8/10 专用包引用 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net452'">
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <!--
      安全钉版：ConfigurationManager 间接引入了这两个包的低版本，
      8.0.1 / 8.0.2 带多个高危公告（GHSA-846f-f764-76mx 等）。
      全局传递钉定（CentralPackageTransitivePinningEnabled）在本仓库不可用——
      它会把高 TFM 的包版本钉进 net452 的还原图导致 NU1202，
      因此在这里用 VersionOverride 显式提升。
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" VersionOverride="9.0.22" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Runtime.Caching" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- 项目引用 -->
  <ItemGroup>
    <ProjectReference Include="..\FastData.Untility\FastData.Untility.csproj" />
  </ItemGroup>

  <!--
    DevTools 工具集：net8.0/net10.0 全量编译；
    net452 因缺少 System.Text.Json 等现代 API，仅保留不依赖它们的文件。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <Compile Remove="DevTools\**" />
    <Compile Include="DevTools\PerformanceProfiler.cs" />
    <Compile Include="DevTools\ApplicationWarmup.cs" />
  </ItemGroup>

  <!-- 排除 net452 不支持的文件（使用 .NET Core+ 专用 API） -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <Compile Remove="Queue\**" />
    
    <Compile Remove="Config\FastDataDependencyInjection.cs" />
    <Compile Remove="Core\ResilientWriteExecutor.cs" />
    <Compile Remove="Extensions\FastDataExtensions.cs" />
    <Compile Remove="Read\FastReadAsync.cs" />
  </ItemGroup>

</Project>
