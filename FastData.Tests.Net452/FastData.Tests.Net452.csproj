<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      .NET Framework 4.5.2 的测试宿主。
      存在的理由：核心库声明支持 net452，但此前 CI 只对它做 dotnet build，
      一条测试都没跑过 —— 「声明支持却不验证」比不支持更危险。

      范围限制：GitHub 的 Windows runner 不支持 service container，
      起不了 SQL Server/MySQL/PostgreSQL，因此这里只覆盖**不依赖数据库**的逻辑：
      表达式解析、SQL 生成、条件构造、加密、脱敏、配置解析等。
      数据库往返仍由 FastData.Tests 在 Linux + 容器上覆盖。

      做法：通过 <Compile Include> 链接 FastData.Tests 下的源文件，
      不复制代码——同一份测试源码在两套目标框架上跑，避免双份维护腐烂。
    -->
    <TargetFramework>net452</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>FastData.Tests</RootNamespace>
    <AssemblyName>FastData.Tests</AssemblyName>
    <!-- 语法用最新编译器，运行时 API 仍受 net452 限制 -->
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      注意：这里不引 xunit.runner.visualstudio —— 2.5+ 已放弃 net452（最低 net462），
      而 2.4.x 又太旧、与 xunit 2.6 不匹配。
      运行改由 xunit.runner.console 的 xunit.console.exe 承担（见 CI），
      它提供 net452 版本的可执行文件。
      SDK 会隐式引入 Microsoft.NETFramework.ReferenceAssemblies，
      因此非 Windows 环境也能编译 net452（运行仍需 Windows）。
    -->
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- net452 需要显式引用这些框架程序集 -->
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Caching" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastData\FastData.csproj" />
    <ProjectReference Include="..\FastData.Untility\FastData.Untility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      链接进来的测试源文件：只挑不碰数据库的那些。
      加文件之前先确认它在 net452 下能编译（net452 目标会排除部分源文件，
      引用了被排除类型的测试在这里会编译失败）。
    -->
    <Compile Include="..\FastData.Tests\EncryptionTests.cs" Link="Linked\EncryptionTests.cs" />
    <Compile Include="..\FastData.Tests\Security\SensitiveDataTests.cs" Link="Linked\SensitiveDataTests.cs" />
    <Compile Include="..\FastData.Tests\TestConfig.cs" Link="Linked\TestConfig.cs" />
    <Compile Include="..\FastData.Tests\ExpressionParsingTests.cs" Link="Linked\ExpressionParsingTests.cs" />
    <Compile Include="..\FastData.Tests\AopTests.cs" Link="Linked\AopTests.cs" />
    <Compile Include="..\FastData.Tests\ExceptionManagerTests.cs" Link="Linked\ExceptionManagerTests.cs" />
    <Compile Include="..\FastData.Tests\PaginationTests.cs" Link="Linked\PaginationTests.cs" />
    <Compile Include="..\FastData.Tests\ConfigParsingTests.cs" Link="Linked\ConfigParsingTests.cs" />
    <Compile Include="..\FastData.Tests\Abstractions\DateTimeProviderTests.cs" Link="Linked\DateTimeProviderTests.cs" />
    <Compile Include="..\FastData.Tests\Config\DataSyncOptionsTests.cs" Link="Linked\DataSyncOptionsTests.cs" />
  </ItemGroup>

</Project>