<?xml version="1.0" encoding="utf-8"?>
<!--
  FastData 测试环境配置

  必填只有三样：Key、Provider、ConnStr。
  其余属性一律不写就用默认值，完整属性表见 FastData/docs/CONFIGURATION.md
-->
<DataConfig Default="SqlServer">
  <Connections>
    <Add Key="SqlServer" Provider="Microsoft.Data.SqlClient"
         ConnStr="server=127.0.0.1,1433;database=FastDataTest;uid=sa;pwd=FastData@Test123;TrustServerCertificate=true;Encrypt=false" />

    <Add Key="MySql" Provider="MySql.Data.MySqlClient"
         ConnStr="server=127.0.0.1;database=FastDataTest;uid=root;pwd=FastData@Test123;SslMode=None;AllowPublicKeyRetrieval=true" />

    <Add Key="PostgreSql" Provider="Npgsql"
         ConnStr="server=127.0.0.1;database=fastdatatest;uid=postgres;pwd=FastData@Test123" />

    <!-- SQLite：文件库，无需 Docker，测试中作为默认连接 -->
    <Add Key="Sqlite" Provider="Microsoft.Data.Sqlite"
         ConnStr="Data Source=FastDataTest-OrmPerf.db"
         IsDefault="true" IsOutError="false" SqlErrorType="file" />
  </Connections>

  <!-- 只需要地址；连接池大小、超时、自动扩缩容都有默认值 -->
  <RedisConfig WriteServerList="127.0.0.1:6379" ReadServerList="127.0.0.1:6379" />

  <!-- 测试环境用小池：用例已串行执行，不需要大连接数 -->
  <ConnectionPool MinPoolSize="5" MaxPoolSize="50" />
</DataConfig>