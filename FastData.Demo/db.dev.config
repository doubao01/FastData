<?xml version="1.0" encoding="utf-8"?>
<!--
  FastData Demo 配置

  必填只有三样：Key、Provider、ConnStr。
  其余属性不写就用默认值，完整属性表见 FastData/docs/CONFIGURATION.md
-->
<DataConfig Default="SqlServer">
  <Connections>
    <Add Key="SqlServer" Provider="Microsoft.Data.SqlClient"
         ConnStr="server=127.0.0.1,1433;database=FastDataDemo;uid=sa;pwd=CHANGE_ME;TrustServerCertificate=true;Encrypt=False"
         IsDefault="true" DesignModel="CodeFirst" />

    <Add Key="Sqlite" Provider="Microsoft.Data.Sqlite"
         ConnStr="Data Source=./demo_data.db" />

    <!--
      CacheType 默认是 web（进程内内存缓存），开箱即用。
      确实配好 Redis 之后再改成 CacheType="redis"；
      未配 Redis 却写 redis 会让缓存静默失效（命中率归零），
      可查 FastData.Untility 的 RedisInfo.IsAvailable 确认状态。
    -->
    <Add Key="MySql" Provider="MySql.Data.MySqlClient"
         ConnStr="server=127.0.0.1;database=FastDataDemo;uid=root;pwd=CHANGE_ME;SslMode=None"
         DesignModel="CodeFirst" />

    <Add Key="PostgreSql" Provider="Npgsql"
         ConnStr="server=127.0.0.1;database=fastdatademo;uid=postgres;pwd=CHANGE_ME"
         DesignModel="CodeFirst" />
  </Connections>

  <RedisConfig WriteServerList="127.0.0.1:6379" ReadServerList="127.0.0.1:6379" />

  <ConnectionPool />
</DataConfig>