# 编译输出
bin/
obj/
*.dll
*.exe
*.so
*.dylib

# 项目特定文件
*.nupkg
*.snk
*.pfx
appsettings.local.json

# 日志文件
*.log
Log/
logs/

# 数据库文件（SQLite 等）
*.db
*.sqlite
*.sqlite3
# SQLite 恢复前留的副本：xxx.db.before-restore-20261030120000，后缀是时间戳，*.db 抓不到
*.before-restore-*

# 用户特定配置
*.user
.vscode/
.idea/
*.suo
*.iml

# 操作系统文件
.DS_Store
Thumbs.db

# 临时文件
tmp/
temp/
*.tmp

# 误提交的临时产物
tdata
FastData.Tests/db_init_result.txt

# 测试输出
TestResults/
coverage/
*.coverage
*.coveragexml

# NuGet 包
packages/
.nuget/

# Docker 数据卷（如果本地挂载）
docker/*/data/

# Node.js（如果有前端项目）
node_modules/
npm-debug.log

# Python（如果有脚本）
__pycache__/
*.py[cod]
.env
.venv/

# AI 助手的本地记忆文件，不应进公开仓库
.monkeycode/

# BenchmarkDotNet 产物：CI 每次跑基准都会生成，属构建产物
BenchmarkDotNet.Artifacts/
