<?xml version="1.0" encoding="utf-8"?>
<DataConfig Default="Sqlite">
  <Connections>
    <!-- SQLite 文件库：不需要安装数据库服务，跑完在当前目录留下 quickstart.db -->
    <Add Key="Sqlite"
         Provider="Microsoft.Data.Sqlite"
         ConnStr="Data Source=quickstart.db"
         IsDefault="true" />
  </Connections>
</DataConfig>